<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="springAppName" source="spring.application.name" defaultValue="connectly-api"/>
    <springProperty scope="context" name="springEnvironment" source="spring.profiles.active" defaultValue="dev"/>

    <!-- Console appender for local development (plain text) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON appender for structured logging (Datadog format) -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${springAppName}","environment":"${springEnvironment}"}</customFields>
        </encoder>
    </appender>

    <!-- Development profile: Plain text console logging with DEBUG -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.jomariabejo.connectly_api" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

    <!-- Stage profile: JSON logging -->
    <springProfile name="stage">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
        <logger name="com.jomariabejo.connectly_api" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
    </springProfile>

    <!-- Demo profile: JSON logging -->
    <springProfile name="demo">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
        <logger name="com.jomariabejo.connectly_api" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
    </springProfile>

    <!-- Production profile: Minimal JSON logging -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
        <logger name="com.jomariabejo.connectly_api" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
    </springProfile>

    <!-- Fallback when no profile is active (e.g. plain bootRun) -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.jomariabejo.connectly_api" level="DEBUG"/>
    </springProfile>

</configuration>
