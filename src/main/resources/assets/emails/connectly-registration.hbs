<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complete your Connectly registration</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f0f2f7;
            color: #0a0a0a;
            font-family: Arial, Helvetica, sans-serif;
        }
        a {
            color: #c8102e;
        }
        .preheader {
            display: none;
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            color: transparent;
            visibility: hidden;
        }
        .shell {
            width: 100%;
            border-collapse: collapse;
            background: #f0f2f7;
        }
        .container {
            width: 100%;
            max-width: 640px;
            margin: 0 auto;
        }
        .panel {
            background: #ffffff;
            border: 1px solid #dce1eb;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(27, 42, 107, 0.08);
        }

        /* ── MASTHEAD ── */
        .masthead {
            background: linear-gradient(135deg, #1b2a6b 0%, #0e1a4a 100%);
            padding: 28px 32px 24px;
        }
        .brand-row {
            width: 100%;
            border-collapse: collapse;
        }
        .logo {
            width: 132px;
            max-width: 132px;
            height: auto;
            display: block;
        }
        .badge {
            display: inline-block;
            padding: 7px 12px;
            border: 1px solid rgba(245, 195, 0, 0.7);
            border-radius: 999px;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
        }

        /* ── MMDC STRIP ── */
        .mmdc-strip {
            background: #c8102e;
            padding: 10px 32px;
            text-align: center;
        }
        .mmdc-strip-text {
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin: 0;
        }
        .mmdc-strip a {
            color: #ffd700;
            text-decoration: none;
        }
        .mmdc-strip a:hover {
            text-decoration: underline;
        }

        /* ── CONTENT ── */
        .content {
            padding: 36px 32px 32px;
        }
        h1 {
            margin: 0 0 14px;
            color: #1b2a6b;
            font-size: 30px;
            line-height: 1.16;
            letter-spacing: -0.01em;
        }
        p {
            margin: 0 0 18px;
            color: #323846;
            font-size: 16px;
            line-height: 1.65;
        }
        .cta-wrap {
            margin: 8px 0 28px;
        }
        .cta {
            display: inline-block;
            padding: 15px 28px;
            background: #c8102e;
            border-radius: 6px;
            color: #ffffff !important;
            font-size: 16px;
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            letter-spacing: 0.02em;
        }
        .note {
            padding: 16px 18px;
            background: #fff9da;
            border-left: 4px solid #f5c300;
            border-radius: 6px;
            color: #4d4320;
            font-size: 14px;
            line-height: 1.55;
            margin-bottom: 22px;
        }
        .link-wrap {
            word-break: break-word;
            color: #586173;
            font-size: 13px;
            line-height: 1.55;
        }

        /* ── DIVIDER ── */
        .divider {
            border: none;
            border-top: 1px solid #eaecf2;
            margin: 28px 0 24px;
        }

        /* ── MMDC INFO BLOCK ── */
        .mmdc-block {
            background: #f5f7fc;
            border: 1px solid #dce1eb;
            border-radius: 8px;
            padding: 18px 20px;
            margin-bottom: 8px;
        }
        .mmdc-block-title {
            margin: 0 0 6px;
            color: #1b2a6b;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .mmdc-block-text {
            margin: 0;
            color: #586173;
            font-size: 13px;
            line-height: 1.55;
        }
        .mmdc-block a {
            color: #c8102e;
            font-weight: 600;
            text-decoration: none;
        }
        .mmdc-block a:hover {
            text-decoration: underline;
        }

        /* ── FOOTER ── */
        .footer {
            padding: 24px 32px 36px;
            text-align: center;
        }
        .footer-main-text {
            color: #697386;
            font-size: 12px;
            line-height: 1.6;
            margin: 0 0 20px;
        }

        /* ── SOCIAL ICONS ── */
        .social-row {
            margin: 0 0 18px;
        }
        .social-link {
            display: inline-block;
            margin: 0 6px;
            border-radius: 10px;
            background: #1b2a6b;
            width: 40px;
            height: 40px;
            line-height: 40px;
            text-align: center;
            text-decoration: none;
            vertical-align: middle;
        }
        .social-link svg {
            display: inline-block;
            vertical-align: middle;
        }

        /* ── MMDC FOOTER LINK ── */
        .mmdc-footer-link {
            display: inline-block;
            margin-top: 10px;
            padding: 7px 16px;
            border: 1px solid #dce1eb;
            border-radius: 999px;
            color: #1b2a6b !important;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            text-decoration: none;
        }
        .footer-copy {
            margin: 16px 0 0;
            color: #adb5c9;
            font-size: 11px;
            line-height: 1.5;
        }

        /* ── RESPONSIVE ── */
        @media only screen and (max-width: 600px) {
            .masthead,
            .content,
            .footer {
                padding-left: 20px;
                padding-right: 20px;
            }
            .mmdc-strip {
                padding-left: 20px;
                padding-right: 20px;
            }
            h1 {
                font-size: 24px;
            }
            .badge {
                margin-top: 14px;
                display: block;
                text-align: center;
            }
        }
    </style>
</head>
<body>
<span class="preheader">{{preheader}}</span>

<table role="presentation" class="shell" cellpadding="0" cellspacing="0">
    <tr>
        <td style="padding: 32px 14px;">
            <table role="presentation" class="container" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="panel">

                        <!-- MASTHEAD -->
                        <div class="masthead">
                            <table role="presentation" class="brand-row" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td align="left">
                                        <img class="logo" src="{{logoCid}}" alt="Connectly">
                                    </td>
                                    <td align="right" valign="top">
                                        <span class="badge">Secure Signup</span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- MMDC STRIP -->
                        <div class="mmdc-strip">
                            <p class="mmdc-strip-text">
                                Powered by <a href="https://www.mmdc.mcl.edu.ph/" target="_blank" rel="noopener">Mapúa Malayan Digital College</a>
                            </p>
                        </div>

                        <!-- MAIN CONTENT -->
                        <div class="content">
                            <h1>Welcome to Connectly.</h1>
                            <p>Your account is almost ready. Confirm your email address to unlock your profile, circles, posts, and the people waiting to connect with you.</p>

                            <div class="cta-wrap">
                                <a class="cta" href="{{verificationLink}}">Verify My Email</a>
                            </div>

                            <p class="note">
                                This verification link expires in <strong>24 hours</strong>. If you did not create a Connectly account, you can safely ignore this email — no action is required.
                            </p>

                            <p class="link-wrap">
                                Button not working? Paste this link into your browser:<br>
                                <a href="{{verificationLink}}">{{verificationLink}}</a>
                            </p>

                            <hr class="divider">

                            <!-- MMDC INFO BLOCK -->
                            <div class="mmdc-block">
                                <p class="mmdc-block-title">About Mapúa Malayan Digital College</p>
                                <p class="mmdc-block-text">
                                    MMDC is the Philippines' premier digital-first online college — offering flexible, affordable IT programs for working students. Learn more at
                                    <a href="https://www.mmdc.mcl.edu.ph/" target="_blank" rel="noopener">mmdc.mcl.edu.ph</a>.
                                </p>
                            </div>
                        </div><!-- /content -->

                    </td>
                </tr>

                <!-- FOOTER -->
                <tr>
                    <td class="footer">
                        <p class="footer-main-text">
                            Connectly keeps your account protected with email verification before sign-in.<br>
                            This email was sent to you because you registered on Connectly.
                        </p>

                        <!-- SOCIAL ICONS -->
                        <div class="social-row">
                            <!-- Instagram -->
                            <a class="social-link" href="https://www.instagram.com/mapuamalayandigital/" target="_blank" rel="noopener" aria-label="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                                </svg>
                            </a>

                            <!-- YouTube -->
                            <a class="social-link" href="https://www.youtube.com/@mapuamalayandigitalcollege" target="_blank" rel="noopener" aria-label="YouTube">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path>
                                    <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon>
                                </svg>
                            </a>

                            <!-- Facebook -->
                            <a class="social-link" href="https://www.facebook.com/MapuaMalayanDigitalCollege" target="_blank" rel="noopener" aria-label="Facebook">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                                </svg>
                            </a>
                        </div>

                        <!-- MMDC website pill -->
                        <div>
                            <a class="mmdc-footer-link" href="https://www.mmdc.mcl.edu.ph/" target="_blank" rel="noopener">
                                Visit MMDC &rarr;
                            </a>
                        </div>

                        <p class="footer-copy">
                            &copy; {{year}} Connectly &bull; Mapúa Malayan Digital College &bull; All rights reserved.
                        </p>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
</body>
</html>
