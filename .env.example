# Connectly API - Environment Template
# Copy this file to .env.stage, .env.demo, .env.prod and update values per environment

# =====================
# ENVIRONMENT CONFIG
# =====================
# Options: dev, stage, demo, prod
SPRING_PROFILE=stage

# =====================
# DATABASE CONFIG
# =====================
DB_PASSWORD=admin
# For production, use a strong password
# DB_PASSWORD=your-secure-database-password

# =====================
# JWT / SECURITY CONFIG
# =====================
# Development JWT secret (MUST change for production)
JWT_SECRET=3cfa76ef14937c1c0ea519f8fc057a80fcd04a7420f8e8bcd0a7567c272e007b

# For production, generate a strong secret:
# JWT_SECRET=$(openssl rand -base64 32)

# =====================
# MAIL CONFIG
# =====================
# Development: use mailpit (running in docker-compose)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Production: use SendGrid, AWS SES, etc.
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# =====================
# DATADOG CONFIG (for production monitoring)
# =====================
# Leave empty for dev/stage/demo
DD_API_KEY=
DD_APP_KEY=
DD_SERVICE=connectly-api
DD_ENVIRONMENT=stage

# =====================
# OAUTH2 CONFIG (optional, if using OAuth2)
# =====================
# OAUTH2_GOOGLE_CLIENT_ID=
# OAUTH2_GOOGLE_CLIENT_SECRET=
# OAUTH2_GITHUB_CLIENT_ID=
# OAUTH2_GITHUB_CLIENT_SECRET=

# =====================
# CORS / SECURITY CONFIG
# =====================
# Allowed CORS origin for frontend
CORS_ORIGIN=http://localhost:3000

# =====================
# APPLICATION CONFIG
# =====================
APP_NAME=connectly-api
APP_VERSION=0.0.1

# Base URL for links in emails (must include /api context path)
# Examples: http://localhost:8080/api (bootRun), http://localhost:8081/api (docker stage)
APP_API_PUBLIC_BASE_URL=http://localhost:8080/api
