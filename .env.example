# ==========================================================
# Connectly API -- local environment
# ==========================================================
#
#   cp .env.example .env
#
# Every value here is OPTIONAL. src/main/resources/application.properties carries the same
# defaults, so `./gradlew bootRun` works with no .env at all. Uncomment only what you change.
#
# Loaded by Spring Boot itself via `spring.config.import=optional:file:.env[.properties]`,
# so this is parsed as a Java properties file:
#   - KEY=value, one per line, no `export`, no quotes (quotes become part of the value)
#   - `#` starts a comment
#   - a literal backslash must be written `\\`
#
# Real environment variables win over this file, so CI and production can set the same
# names without shipping a .env.
#
# .env is gitignored. Never commit it.

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
#SERVER_PORT=8080

# ----------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------
# Create the database first:  createdb connectly_db
#DB_URL=jdbc:postgresql://localhost:5432/connectly_db
#DB_USERNAME=postgres
#DB_PASSWORD=admin

# Hibernate schema handling.
#   create-drop  rebuild on start, DROP ON SHUTDOWN  (default; local only -- destroys data)
#   update       apply additive changes, keep data
#   validate     verify the schema matches the entities, change nothing
#   none         leave the schema alone
# Use validate or none anywhere you care about the data.
#JPA_DDL_AUTO=create-drop
#JPA_SHOW_SQL=true

# ----------------------------------------------------------
# JWT
# ----------------------------------------------------------
# The default committed in application.properties is a throwaway dev key and is public.
# Generate your own for anything that is not your laptop:
#   openssl rand -hex 32
#JWT_SECRET=replace-me-with-openssl-rand-hex-32
# Token lifetime in milliseconds (3600000 = 1 hour)
#JWT_EXPIRATION_MS=3600000

# ----------------------------------------------------------
# Mail (SMTP)
# ----------------------------------------------------------
# Defaults target Mailpit/MailHog on localhost, which captures mail instead of sending it:
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# Then read the verification and password-reset mail at http://localhost:8025
#MAIL_HOST=localhost
#MAIL_PORT=1025
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_SMTP_AUTH=false
#MAIL_SMTP_STARTTLS=false

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated. Add your frontend's origin here.
#CORS_ALLOWED_ORIGINS=http://localhost:3000
#CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE

# ----------------------------------------------------------
# Password reset
# ----------------------------------------------------------
# How long a reset link or OTP stays valid
#PASSWORD_RESET_EXPIRY_MINUTES=15
# Reset requests allowed per address inside the attempt window
#PASSWORD_RESET_MAX_ATTEMPTS=5
#PASSWORD_RESET_ATTEMPT_WINDOW_MINUTES=60
# Wrong-OTP guesses before the code is burned
#PASSWORD_RESET_MAX_OTP_ATTEMPTS=3
# How often expired tokens are swept, in milliseconds
#PASSWORD_RESET_CLEANUP_INTERVAL_MS=3600000
#PASSWORD_MIN_LENGTH=8
# Where the emailed reset link points -- set this to your frontend's reset page
#PASSWORD_RESET_REDIRECT_URL=http://localhost:8080/reset-password

# ----------------------------------------------------------
# Docs
# ----------------------------------------------------------
# Set false to hide Swagger UI and /v3/api-docs (recommended for public deployments)
#SWAGGER_ENABLED=true

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
#LOG_LEVEL_APP=DEBUG
#LOG_LEVEL_WEB=INFO
#LOG_LEVEL_SECURITY=DEBUG

# ----------------------------------------------------------
# OAuth2 (not wired up yet)
# ----------------------------------------------------------
# The Google/Facebook blocks in application.properties are commented out. Uncomment them
# there as well as here before these take effect.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#FACEBOOK_CLIENT_ID=
#FACEBOOK_CLIENT_SECRET=
